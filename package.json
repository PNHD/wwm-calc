{
  "name": "yanyun-calculator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "apply:global-v2": "node scripts/apply-global-v2.mjs && node scripts/apply-global-t96-live.mjs && node scripts/apply-global-v2-innerways.mjs && node scripts/apply-global-t96-ocr.mjs && node scripts/apply-global-v2-finalize.mjs && node scripts/validate-global-v2.mjs",
    "audit:global-v2": "npm run apply:global-v2",
    "predev": "npm run apply:global-v2",
    "dev": "vite",
    "prebuild": "npm run apply:global-v2 && node scripts/write-build-info.mjs",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "lint": "tsc --noEmit",
    "deploy": "npm run deploy:pages",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name wonton-wwm",
    "deploy:worker": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tesseract.js": "^7.0.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.42.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "wrangler": "^4.103.0"
  }
}
